IDD_ABOUT DIALOGEX 0, 0, 255, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Notepad4"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,142,123,50,14
    PUSHBUTTON      "复制",IDC_COPY_BUILD_INFO,198,123,50,14
    ICON            IDR_MAINWND,IDC_STATIC,14,7,20,20
    LTEXT           "",IDC_VERSION,45,7,200,8
    LTEXT           "",IDC_BUILD_INFO,45,18,200,16
    LTEXT           "版权所有 ? 2011-2026 Zufu Liu 和所有贡献者.",IDC_STATIC,20,38,230,8
    CONTROL         "",IDC_NEW_PAGE_LINK,"SysLink",WS_TABSTOP,20,48,200,10
    LTEXT           "版权所有 ? 2010-2017 XhmikosR 和所有贡献者.",IDC_STATIC,20,60,200,8
    CONTROL         "",IDC_MOD_PAGE_LINK,"SysLink",WS_TABSTOP,20,68,200,10
    LTEXT           "版权所有 ? 2004-2012 Florian Balmer.",IDC_STATIC,20,80,200,8
    CONTROL         "",IDC_WEBPAGE_LINK,"SysLink",WS_TABSTOP,20,88,200,10
    LTEXT           "联系 Florian Balmer:",IDC_STATIC,20,100,94,8
    CONTROL         "",IDC_EMAIL_LINK,"SysLink",WS_TABSTOP,20,108,94,10
    LTEXT           "访问 Scintilla 网站:",IDC_STATIC,20,120,94,8
    CONTROL         "",IDC_SCI_PAGE_LINK,"SysLink",WS_TABSTOP,20,128,94,10
END

IDD_FIND DIALOGEX 0, 0, 290, 124
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "查找文本"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "搜索字符串(&G): ",IDC_STATIC,7,7,67,8
    COMBOBOX        IDC_FINDTEXT,7,17,210,116,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "匹配大小写(&C)",IDC_FINDCASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,37,73,10
    CONTROL         "只匹配完整单词(&W)",IDC_FINDWORD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,49,110,10
    CONTROL         "只匹配单词开头(&B)",IDC_FINDSTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,61,124,10
    CONTROL         "正则表达式搜索(&E)",IDC_FINDREGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,73,112,10
