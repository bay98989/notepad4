            MENUITEM "列块左移(&L)",                    IDM_EDIT_MOVE_BLOCK_LEFT
            MENUITEM "列块右移(&R)",                    IDM_EDIT_MOVE_BLOCK_RIGHT
            MENUITEM "自动增加行号(&N)...",               IDM_EDIT_COLUMNEDIT
        END
        POPUP "行编辑(&L)"
        BEGIN
            MENUITEM "上移(&U)\tAlt+Up",              IDM_EDIT_MOVELINEUP
            MENUITEM "下移(&V)\tAlt+Down",            IDM_EDIT_MOVELINEDOWN
            MENUITEM "与上一行交换(&R)\tAlt+S",           IDM_EDIT_LINETRANSPOSE
            MENUITEM SEPARATOR
            MENUITEM "行排序(&O)...\tAlt+O",           IDM_EDIT_SORTLINES
            MENUITEM "行修改(&M)...\tAlt+M",           IDM_EDIT_MODIFYLINES
            MENUITEM "行对齐(&N)...\tAlt+J",           IDM_EDIT_ALIGN
            MENUITEM SEPARATOR
            MENUITEM "重复行(&D)\tCtrl+D",             IDM_EDIT_DUPLICATELINE
            MENUITEM "剪切行(&T)\tCtrl+Shift+X",       IDM_EDIT_CUTLINE
            MENUITEM "复制行(&C)\tCtrl+Shift+C",       IDM_EDIT_COPYLINE
            MENUITEM "删除行(&E)\tCtrl+Shift+D",       IDM_EDIT_DELETELINE
            MENUITEM SEPARATOR
            MENUITEM "行合并(&J)\tCtrl+J",             IDM_EDIT_JOINLINES
            MENUITEM "行切分(&S)\tCtrl+I",             IDM_EDIT_SPLITLINES
            MENUITEM "段落切分(&W)...",                 IDM_EDIT_COLUMNWRAP
            MENUITEM "段落合并(&P)\tCtrl+Shift+J",      IDM_EDIT_JOINLINESEX
        END
    END
    POPUP "+"
    BEGIN
        MENUITEM "显示菜单(&M)",                    IDM_VIEW_MENU
        MENUITEM "显示工具栏(&T)",                   IDM_VIEW_TOOLBAR
        MENUITEM "自定义工具栏(&C)...",               IDM_VIEW_CUSTOMIZE_TOOLBAR
        MENUITEM "工具栏比例自适应(&A)",                IDM_VIEW_AUTO_SCALE_TOOLBAR
        MENUITEM "使用大工具栏(&L)",                  IDM_VIEW_USE_LARGE_TOOLBAR
        MENUITEM "显示状态栏(&S)",                   IDM_VIEW_STATUSBAR
    END
    POPUP "+"
    BEGIN
        MENUITEM "打开 Notepad4(&O)",             IDM_TRAY_RESTORE
        MENUITEM SEPARATOR
        MENUITEM "退出 Notepad4(&X)",             IDM_TRAY_EXIT
    END
    POPUP "+"
    BEGIN
        MENUITEM "默认级别(&D)",                    IDM_VIEW_FOLD_DEFAULT
        MENUITEM "所有级别(&A)",                    IDM_VIEW_FOLD_ALL
        MENUITEM "当前代码块(&C)",                   IDM_VIEW_FOLD_CURRENT_BLOCK
        MENUITEM "当前级别(&L)",                    IDM_VIEW_FOLD_CURRENT_LEVEL
        MENUITEM SEPARATOR
        MENUITEM "级别 &1",                       IDM_VIEW_FOLD_LEVEL1
        MENUITEM "级别 &2",                       IDM_VIEW_FOLD_LEVEL2
        MENUITEM "级别 &3",                       IDM_VIEW_FOLD_LEVEL3
        MENUITEM "级别 &4",                       IDM_VIEW_FOLD_LEVEL4
        MENUITEM "级别 &5",                       IDM_VIEW_FOLD_LEVEL5
        MENUITEM "级别 &6",                       IDM_VIEW_FOLD_LEVEL6
        MENUITEM "级别 &7",                       IDM_VIEW_FOLD_LEVEL7
        MENUITEM "级别 &8",                       IDM_VIEW_FOLD_LEVEL8
        MENUITEM "级别 &9",                       IDM_VIEW_FOLD_LEVEL9
        MENUITEM "级别 1&0",                      IDM_VIEW_FOLD_LEVEL10
    END
END


