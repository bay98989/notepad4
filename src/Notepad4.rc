IDR_MAINWND MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建(&N)\tCtrl+N",              IDM_FILE_NEW
        MENUITEM "打开(&O)...\tCtrl+O",           IDM_FILE_OPEN
        MENUITEM "保存(&S)\tCtrl+S",              IDM_FILE_SAVE
        MENUITEM "另存为(&A)...\tF6",              IDM_FILE_SAVEAS
        MENUITEM SEPARATOR
        POPUP "编码(&E)"
        BEGIN
            MENUITEM "&ANSI",                       IDM_ENCODING_ANSI
            MENUITEM "UTF-&8",                      IDM_ENCODING_UTF8
            MENUITEM "UTF-8 B&OM",                  IDM_ENCODING_UTF8SIGN
            MENUITEM "更多(&M)...\tF9",               IDM_ENCODING_SELECT
            MENUITEM SEPARATOR
            MENUITEM "默认(&D)...",                   IDM_ENCODING_SETDEFAULT
        END
        MENUITEM SEPARATOR
        MENUITEM "页面设置(&T)...",                 IDM_FILE_PAGESETUP
        MENUITEM "打印(&P)...\tCtrl+P",           IDM_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)\tAlt+F4",              IDM_FILE_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "撤销(&U)\tCtrl+Z",              IDM_EDIT_UNDO
        MENUITEM "重做(&R)\tCtrl+Y",              IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "剪切(&T)\tCtrl+X",              IDM_EDIT_CUT
        MENUITEM "复制(&C)\tCtrl+C",              IDM_EDIT_COPY
        MENUITEM "粘贴(&P)\tCtrl+V",              IDM_EDIT_PASTE
        MENUITEM "删除(&D)\tDelete",              IDM_EDIT_DELETE
        MENUITEM "全选(&A)\tCtrl+A",              IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        POPUP "转换(&V)"
        BEGIN
            MENUITEM "大写(&U)\tCtrl+Shift+U",        IDM_EDIT_CONVERTUPPERCASE
            MENUITEM "小写(&L)\tCtrl+U",              IDM_EDIT_CONVERTLOWERCASE
            MENUITEM "反转大小写(&V)\tCtrl+Alt+U",       IDM_EDIT_INVERTCASE
            MENUITEM SEPARATOR
            MENUITEM "空格转制表符(&T)\tCtrl+Shift+T",    IDM_EDIT_CONVERTSPACES
            MENUITEM "制表符转空格(&N)\tCtrl+Shift+S",    IDM_EDIT_CONVERTTABS
            MENUITEM "使用制表符缩进(&I)\tCtrl+Alt+T",     IDM_EDIT_CONVERTSPACES2
            MENUITEM "使用空格缩进(&F)\tCtrl+Alt+S",      IDM_EDIT_CONVERTTABS2
            MENUITEM SEPARATOR
            MENUITEM "转十六进制(&H)\tCtrl+Alt+H",       IDM_EDIT_NUM2HEX
            MENUITEM "转十进制(&D)\tCtrl+Alt+D",        IDM_EDIT_NUM2DEC
        END
        POPUP "插入(&N)"
        BEGIN
            MENUITEM "单词自动完成(&W)\tAlt+/",           IDM_EDIT_COMPLETEWORD
            MENUITEM SEPARATOR
            MENUITEM "当前日期(&D)",                    IDM_EDIT_INSERT_LOC_DATE
            MENUITEM "当前日期和时间(&T)",                 IDM_EDIT_INSERT_LOC_DATETIME
            MENUITEM "时间/日期(短格式)(&S)\tCtrl+F5",     IDM_EDIT_INSERT_SHORTDATE
            MENUITEM "时间/日期(长格式)(&L)\tCtrl+Shift+F5", IDM_EDIT_INSERT_LONGDATE
        END
        MENUITEM SEPARATOR
        POPUP "列编辑"
        BEGIN
            MENUITEM "添加/取消行注释(&O)\tCtrl+/",        IDM_EDIT_LINECOMMENT
            MENUITEM "添加/取消块注释(&C)\tCtrl+Q",        IDM_EDIT_STREAMCOMMENT
            MENUITEM "增加缩进(&I)\tTab",               IDM_EDIT_INDENT
            MENUITEM "减少缩进(&U)\tShift+Tab",         IDM_EDIT_UNINDENT
